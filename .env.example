# Optional: keep real API credentials in .env.local (never commit that file).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required only for production e-mail confirmation via Resend.
RESEND_API_KEY=
AUTH_EMAIL_FROM="AI Sana <onboarding@your-domain.example>"

# Optional: absolute path to a persistent SQLite directory (default: ./data).
# AI_SANA_DATA_DIR=/var/lib/ai-sana
